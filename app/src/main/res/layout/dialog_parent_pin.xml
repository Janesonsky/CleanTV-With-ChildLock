<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_menu_bubble"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/tv_pin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 请输入家长密码"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_pin_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="输入 4 位数字密码（默认 1234）"
        android:textColor="#B0C4DE"
        android:textSize="14sp" />

    <!-- 4 个 PIN 点 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:id="@+id/pin_dot_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_margin="8dp"
            android:background="@drawable/status_dot" />

        <View
            android:id="@+id/pin_dot_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_margin="8dp"
            android:background="@drawable/status_dot" />

        <View
            android:id="@+id/pin_dot_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_margin="8dp"
            android:background="@drawable/status_dot" />

        <View
            android:id="@+id/pin_dot_4"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_margin="8dp"
            android:background="@drawable/status_dot" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="密码错误，请重试"
        android:textColor="#FFFF453A"
        android:textSize="14sp"
        android:visibility="invisible" />

    <!-- 简易按键行，遥控器可点，也可以直接按物理遥控器数字键 -->
    <EditText
        android:id="@+id/et_hidden_pin"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:background="@null"
        android:focusable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_pin_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_menu_item"
            android:text="取消"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_pin_clear"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_menu_item"
            android:text="清除"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="💡 提示：可直接按遥控器数字键输入"
        android:textColor="#78909C"
        android:textSize="12sp" />

</LinearLayout>
